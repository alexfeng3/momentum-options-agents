# ---------------------------------------------------------------------------
# Alpaca PAPER credentials only. Never put live-trading keys in this file.
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# REQUIRED account allowlist. The system refuses to trade unless the account your
# credentials resolve to matches this EXACTLY *and* its SHA-256 appears in
# ALLOWED_ACCOUNT_HASHES in src/options_agents/broker.py.
#
# Editing this file can only NARROW the allowlist, never widen it. To trade a
# different paper account, add its hash to broker.py:
#   python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" PA1234ABCD
ALPACA_ACCOUNT_NUMBER=

# Hard gate: no order is submitted unless this is exactly "true".
PAPER_TRADING=true

# Market data feed: "iex" (free) or "sip" (paid, full consolidated tape).
ALPACA_DATA_FEED=iex

# Optional. Without it the Judgment Agent abstains and the deterministic
# pipeline runs unchanged.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- optional strategy overrides; defaults shown ---------------------------
# TOP_N=6
# CORE_WEIGHT=0.80
# MAX_POSITIONS=10
# MAX_POSITION_PCT=0.20
# MARKET_FILTER=true
# OVERLAY_ENABLED=true
# SHORT_DELTA=0.20
# WIDTH_PCT=0.10
# DTE=30
# IV_RANK_MIN=20
# RISK_PER_SPREAD=0.03
# MAX_OVERLAY_RISK=0.15
# MIN_PRICE=10
# MAX_VOL=0.60

# SEC EDGAR requires a descriptive User-Agent with real contact details.
SEC_USER_AGENT=your-name-research you@example.com
